# MySQL — tuned for a local development machine.
# Stock defaults assume a dedicated server and cost ~550 MB resident while idle;
# these settings bring that to ~250 MB. Measured on MySQL 9.6 / 8 GB Apple Silicon.

[mysqld]
bind-address = 127.0.0.1

# performance_schema pre-allocates ~200 MB at startup regardless of load.
# Comment this out (and restart) when you actually need query analysis.
performance_schema      = OFF

innodb_buffer_pool_size = 64M     # default 128M; local DBs are small
innodb_log_buffer_size  = 16M     # default 64M
max_connections         = 30      # default 151 — server-scale
table_open_cache        = 400     # default 4000

# X Protocol / MySQL Shell (port 33060). Set to 1 if you use MySQL Shell.
# NOTE: with mysqlx = 0 you must NOT set mysqlx-bind-address — the variable
# does not exist when the plugin is unloaded and mysqld will refuse to start.
mysqlx = 0
