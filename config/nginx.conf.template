# Homebrew nginx — local *.{{TLD}} development.
# Generated by brew-dev-stack. Site config lives in servers/local-dev.conf.

user "{{USER}}" {{GROUP}};
worker_processes auto;

error_log  {{BREW}}/var/log/nginx/error.log warn;
pid        {{BREW}}/var/run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include       mime.types;
    default_type  application/octet-stream;

    access_log {{BREW}}/var/log/nginx/access.log;

    sendfile            on;
    tcp_nopush          on;
    keepalive_timeout   65;
    types_hash_max_size 2048;
    server_names_hash_bucket_size 128;
    client_max_body_size 512M;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript
               text/xml application/xml image/svg+xml;

    # Reject any hostname we do not explicitly serve.
    server {
        listen 127.0.0.1:80 default_server;
        server_name _;
        return 444;
    }

    include servers/*.conf;
}
