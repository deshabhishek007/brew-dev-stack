# Mailpit web UI at https://mailpit.{{TLD}}
# An exact server_name beats the wildcard regex vhost, so this takes precedence.
server {
    listen 127.0.0.1:80;
    listen 127.0.0.1:443 ssl;
    http2 on;

    server_name mailpit.{{TLD}};

    ssl_certificate     {{BREW}}/etc/nginx/certs/local-{{TLD}}.pem;
    ssl_certificate_key {{BREW}}/etc/nginx/certs/local-{{TLD}}-key.pem;

    location / {
        proxy_pass http://127.0.0.1:8025;
        proxy_http_version 1.1;
        # Mailpit's UI live-updates over a websocket; without these the list
        # loads but never refreshes as new mail arrives.
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host       $host;
        proxy_set_header X-Real-IP  $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
    }
}
