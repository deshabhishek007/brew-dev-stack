<?php
/**
 * phpMyAdmin — LOCAL DEVELOPMENT ONLY.
 *
 * blowfish_secret must be exactly 32 characters. If it is empty, phpMyAdmin
 * still returns HTTP 200 but cookie auth silently never completes — the most
 * common "phpMyAdmin won't log in" cause.
 */
declare(strict_types=1);

$cfg['blowfish_secret'] = '{{SECRET}}';

$i = 0;

$i++;
$cfg['Servers'][$i]['auth_type']       = 'cookie';
$cfg['Servers'][$i]['host']            = '127.0.0.1';
$cfg['Servers'][$i]['port']            = 3306;
$cfg['Servers'][$i]['compress']        = false;
$cfg['Servers'][$i]['AllowNoPassword'] = true;   // local root usually has none

$cfg['UploadDir'] = '';
$cfg['SaveDir']   = '';
$cfg['TempDir']   = '{{BREW}}/var/tmp/phpmyadmin';
