#!/usr/bin/env bash
#
# devstack — start/stop/status helper for brew-dev-stack.
#
set -euo pipefail

# Settings resolve as: environment variable > config file > default.
# The config file is written by install.sh so the CLI uses the same sites
# directory, TLD and PHP version the stack was actually configured with.
CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/brew-dev-stack/config"
_env_TLD="${TLD:-}"; _env_SITES="${SITES_DIR:-}"; _env_PHP="${PHP_VERSION:-}"
# shellcheck source=/dev/null
[[ -f "$CONFIG_FILE" ]] && . "$CONFIG_FILE"
TLD="${_env_TLD:-${TLD:-test}}"
SITES_DIR="${_env_SITES:-${SITES_DIR:-$HOME/sites}}"
PHP_VERSION="${_env_PHP:-${PHP_VERSION:-8.3}}"
BREW="$(brew --prefix)"
PHPSHORT="${PHP_VERSION//./}"

# `producer | grep -q` is unsafe under `set -o pipefail`: grep -q exits at the
# first match and closes the pipe, the producer dies of SIGPIPE and exits
# non-zero, and pipefail then fails the whole pipeline. Which process finishes
# first is a race, so it shows up as flakiness rather than a clear error.
# Capture the output first and match against a here-string: no pipeline, no race.
out_of() { "$@" 2>/dev/null || true; }

ok()   { printf '  \033[32m✓\033[0m %s\n' "$*"; }
bad()  { printf '  \033[31m✗\033[0m %s\n' "$*"; }
warn() { printf '  \033[33m!\033[0m %s\n' "$*"; }

usage() {
  cat <<'EOF'
Usage: devstack <command> [options]

Sites
  new <name> [--type=wordpress|laravel|plain]  create site, database, certificate
  list [--json]                                all sites: type, repo, URL
  rm <name> [--keep-db] [--keep-files]         delete site and database
  tunnel <name>                                expose a site publicly for webhook testing
  queue <name> [on|off]                        Laravel queue:work as a managed worker
  schedule <name> [on|off]                     Laravel schedule:run every minute

Stack
  status                    what is running and listening
  doctor [--json]           diagnose why something is not working
  start | stop              start or stop the stack (nginx, dnsmasq need sudo)
  reload                    regenerate certificate, reload nginx
  logs [nginx|access|php|fpm|all|<site>]
                            follow a log; a site name gives its debug.log

Configure
  config [--show]           your name, email, admin username
  php [version] [--site=<name>]
                            show, change the default, or pin one site
  mysql perf [on|off]       performance_schema (~200 MB when ON)
  install adminer           web UI for MySQL, PostgreSQL and SQLite
  install mailpit           catch all outgoing mail (nothing reaches real inboxes)
  install xdebug            step debugger and profiler (dormant until triggered)
  install redis             cache, sessions and queues, with the PHP extension

  help, --version

Settings live in ~/.config/brew-dev-stack/config; environment variables override.
EOF
}

cmd_status() {
  echo "Services"
  # Only report on formulae that are actually installed — hardcoding a list
  # means reporting "not started" for something the user removed.
  local svc installed=()
  brew list --versions "php@$PHP_VERSION" >/dev/null 2>&1 && installed+=("php@$PHP_VERSION")
  for svc in mysql mariadb redis; do
    brew list --versions "$svc" >/dev/null 2>&1 && installed+=("$svc")
  done
  while IFS= read -r svc; do
    [[ -n "$svc" ]] && installed+=("$svc")
  done < <(brew list --formula 2>/dev/null | grep -E '^postgresql(@[0-9]+)?$')

  for svc in "${installed[@]}"; do
    if grep -qE "^${svc//./\\.} +started" <<<"$(out_of brew services list)"; then ok "$svc"; else warn "$svc not started"; fi
  done
  (( ${#installed[@]} )) || warn "no database or php services installed"
  # nginx rewrites its argv to "nginx: master process …", so `pgrep -x nginx`
  # finds nothing even while it is serving. Match the master line instead.
  pgrep -f 'nginx: master' >/dev/null && ok "nginx running" || bad "nginx not running"
  pgrep -f "$BREW/opt/dnsmasq" >/dev/null && ok "dnsmasq running" || bad "dnsmasq not running"

  echo
  echo "Listeners"
  lsof -nP -iTCP:80 -iTCP:443 -sTCP:LISTEN 2>/dev/null | awk '/LISTEN/{print "  "$1, $9}' | sort -u || warn "nothing on 80/443"

  echo
  echo "PHP socket"
  [[ -S "$BREW/var/run/php${PHPSHORT}-fpm.sock" ]] && ok "php${PHPSHORT}-fpm.sock" || bad "socket missing"

  echo
  echo "Sites in $SITES_DIR"
  local n=0
  for d in "$SITES_DIR"/*/; do [[ -d "$d" ]] && n=$((n+1)); done
  echo "  $n project(s)"
}

cmd_start() {
  brew services start "php@$PHP_VERSION"
  echo "dnsmasq and nginx need root:"
  sudo brew services start dnsmasq
  sudo brew services start nginx
}

cmd_stop() {
  brew services stop "php@$PHP_VERSION" || true
  sudo brew services stop nginx || true
  sudo brew services stop dnsmasq || true
}

cmd_reload() {
  "$(dirname "${BASH_SOURCE[0]}")/site-cert-regen"
  sudo nginx -s reload && ok "nginx reloaded"
}

cmd_logs() {
  local what="${1:-}"
  case "$what" in
    nginx|"")  echo "→ nginx errors (ctrl-c to stop)"; tail -f "$BREW/var/log/nginx/${TLD}-error.log" ;;
    access)    echo "→ nginx access";  tail -f "$BREW/var/log/nginx/${TLD}-access.log" ;;
    php)       echo "→ php errors";    tail -f "$BREW/var/log/php-error.log" ;;
    fpm)       echo "→ php-fpm";       tail -f "$BREW/var/log/php-fpm-${PHP_VERSION}.log" ;;
    all)       echo "→ nginx + php together"
               tail -f "$BREW/var/log/nginx/${TLD}-error.log" "$BREW/var/log/php-error.log" ;;
    *)
      # A site name: WordPress writes its own debug.log when WP_DEBUG_LOG is on.
      local wp="$SITES_DIR/$what/wp-content/debug.log"
      if [[ -f "$wp" ]]; then echo "→ $what WordPress debug.log"; tail -f "$wp"
      elif [[ -d "$SITES_DIR/$what" ]]; then
        bad "No debug.log for $what yet (WordPress creates it on the first logged error)"
        echo "       Laravel: tail -f $SITES_DIR/$what/storage/logs/laravel.log"
        exit 1
      else bad "Unknown log '$what'. Use: nginx, access, php, fpm, all, or a site name"; exit 1; fi ;;
  esac
}

cmd_doctor() {
  # In JSON mode ok/bad/warn append a row instead of printing.
  local drows=""
  if (( JSON )); then
    drows="$(mktemp)"
    ok()   { printf 'pass%s%s\n' "$SEP" "$*" >> "$drows"; }
    bad()  { printf 'fail%s%s\n' "$SEP" "$*" >> "$drows"; }
    warn() { printf 'warn%s%s\n' "$SEP" "$*" >> "$drows"; }
  else
    echo "Checks"
  fi
  [[ -f "/etc/resolver/$TLD" ]] && ok "/etc/resolver/$TLD present" \
    || bad "/etc/resolver/$TLD missing — .$TLD will not resolve"

  if grep -q 127.0.0.1 <<<"$(out_of dig +short +time=2 +tries=1 @127.0.0.1 "probe.$TLD")"; then
    ok "dnsmasq answers *.$TLD"
  else
    bad "dnsmasq is not answering *.$TLD"
  fi

  security find-certificate -c mkcert /Library/Keychains/System.keychain >/dev/null 2>&1 \
    && ok "mkcert CA trusted" || bad "mkcert CA not trusted — run: mkcert -install"

  local cert="$BREW/etc/nginx/certs/local-${TLD}.pem"
  if [[ -f "$cert" ]]; then
    local sans; sans=$(openssl x509 -in "$cert" -noout -ext subjectAltName 2>/dev/null | tr ',' '\n' | grep -c 'DNS' || true)
    ok "certificate present ($sans SANs)"
    if grep -q "DNS:\*\.$TLD" <<<"$(out_of openssl x509 -in "$cert" -noout -ext subjectAltName)"; then
      bad "certificate uses a *.$TLD wildcard — clients reject wildcards directly under a TLD"
    fi
  else
    bad "certificate missing — run site-cert-regen"
  fi

  # A root-owned shared php-fpm log makes launchd fail php@X with status 78.
  local shared="$BREW/var/log/php-fpm.log"
  if [[ -f "$shared" && ! -w "$shared" ]]; then
    bad "$shared is not writable by you — php-fpm may fail to start (status 78)"
  fi

  grep -q 'syntax is ok' <<<"$(nginx -t 2>&1 || true)" && ok "nginx config syntax ok" \
    || warn "run 'sudo nginx -t' for a full config check"

  # Mail: the failure mode here is silent real delivery, so check it explicitly.
  local sp; sp="$(php -r 'echo ini_get("sendmail_path");' 2>/dev/null)"
  if [[ "$sp" == *mailpit* ]]; then
    if curl -sf --max-time 3 http://127.0.0.1:8025/readyz >/dev/null 2>&1; then
      ok "mail captured by Mailpit (php mail() routed, inbox reachable)"
      grep -q '127.0.0.1:8025' <<<"$(out_of lsof -nP -iTCP:8025 -sTCP:LISTEN)" \
        || bad "Mailpit is listening beyond 127.0.0.1 — captured mail is reachable from your network"
    else
      bad "php mail() points at Mailpit but Mailpit is not responding — mail is being lost"
    fi
  elif [[ -z "$sp" ]]; then
    warn "php sendmail_path is empty — mail() will fail"
  else
    bad "php mail() goes to $sp — a local site could email a real address"
    echo "       install a catcher with:  devstack install mailpit"
  fi

  if (( JSON )); then
    json_rows_to_array 'status,message' < "$drows"
    rm -f "$drows"
    return 0
  fi

  # php-fpm reads php.ini at start; a stale worker keeps the old sendmail_path.
  if [[ "$sp" == *mailpit* ]] && [[ -f "$BREW/etc/php/$PHP_VERSION/conf.d/zz-mailpit.ini" ]]; then
    local ini_age fpm_age
    ini_age=$(stat -f %m "$BREW/etc/php/$PHP_VERSION/conf.d/zz-mailpit.ini" 2>/dev/null || echo 0)
    fpm_age=$(ps -o lstart= -p "$(pgrep -f "php-fpm: master.*$PHP_VERSION" | head -1)" 2>/dev/null | xargs -I{} date -j -f "%a %b %e %T %Y" {} +%s 2>/dev/null || echo 0)
    if [[ "$fpm_age" != "0" && "$ini_age" -gt "$fpm_age" ]]; then
      warn "php-fpm started before the mail config changed — restart it:  brew services restart php@$PHP_VERSION"
    fi
  fi
}


# --- php version map -------------------------------------------------------
PHPMAP="$BREW/etc/nginx/php-versions.map"

php_sock() { printf '%s/var/run/php%s-fpm.sock' "$BREW" "${1//./}"; }

# Make sure php@<ver> exists, listens on its own socket and its own log, and
# is running. Safe to call repeatedly.
php_prepare() {
  # NOTE: `local a=x b=$a` does not work — local expands all its arguments
  # before any assignment takes effect, so b sees an unset a.
  local ver="$1"
  local short="${ver//./}"
  brew list --versions "php@$ver" >/dev/null 2>&1 || { echo "Installing php@$ver…"; brew install "php@$ver" >/dev/null; }
  local pool="$BREW/etc/php/$ver/php-fpm.d/www.conf" conf="$BREW/etc/php/$ver/php-fpm.conf"
  [[ -f "$pool" ]] || { bad "no pool config at $pool"; return 1; }
  /usr/bin/sed -i '' \
    -e "s|^listen = .*|listen = $BREW/var/run/php${short}-fpm.sock|" \
    -e "s|^;\{0,1\}listen.owner = .*|listen.owner = $USER|" \
    -e "s|^;\{0,1\}listen.group = .*|listen.group = $(id -gn)|" \
    -e "s|^;\{0,1\}listen.mode = .*|listen.mode = 0660|" "$pool"
  /usr/bin/sed -i '' "s|^;\{0,1\}error_log = .*|error_log = $BREW/var/log/php-fpm-${ver}.log|" "$conf"
  for stale in "$BREW/etc/php/$ver/php-fpm.d/"*valet*.conf; do
    [[ -e "$stale" ]] && mv "$stale" "$stale.disabled"
  done
  # Always restart: `start` on an already-running service succeeds without
  # reloading, so the pool changes above would never take effect.
  brew services restart "php@$ver" >/dev/null 2>&1
  local i
  for i in $(seq 1 20); do [[ -S "$(php_sock "$ver")" ]] && break; sleep 1; done
  [[ -S "$(php_sock "$ver")" ]] || { bad "php@$ver socket never appeared — see $BREW/var/log/php-fpm-${ver}.log"; return 1; }
  return 0
}

php_map_default() {  # current default version, or empty
  [[ -f "$PHPMAP" ]] || return 0
  sed -nE 's|^[[:space:]]*default[[:space:]]+.*/php([0-9]+)-fpm\.sock;.*|\1|p' "$PHPMAP" | head -1
}

php_map_write() {  # php_map_write <site|default> <version>
  local key="$1" ver="$2" sock
  sock="$(php_sock "$ver")"
  mkdir -p "$(dirname "$PHPMAP")"
  [[ -f "$PHPMAP" ]] || printf 'default %s;\n' "$(php_sock "$PHP_VERSION")" > "$PHPMAP"
  # Rewrite without the key, then append it — keeps the file idempotent.
  local tmp; tmp="$(mktemp)"
  grep -vE "^[[:space:]]*${key}[[:space:]]" "$PHPMAP" > "$tmp" 2>/dev/null || true
  printf '%s %s;\n' "$key" "$sock" >> "$tmp"
  # default must exist and sort first for readability
  grep -qE '^[[:space:]]*default[[:space:]]' "$tmp" || printf 'default %s;\n' "$(php_sock "$PHP_VERSION")" >> "$tmp"
  { grep -E '^[[:space:]]*default[[:space:]]' "$tmp"; grep -vE '^[[:space:]]*default[[:space:]]' "$tmp" | sort; } > "$PHPMAP"
  rm -f "$tmp"
}

php_map_remove() {  # drop a site's override
  [[ -f "$PHPMAP" ]] || return 0
  local tmp; tmp="$(mktemp)"
  grep -vE "^[[:space:]]*${1}[[:space:]]" "$PHPMAP" > "$tmp" 2>/dev/null || true
  mv "$tmp" "$PHPMAP"
}

# --- php version -----------------------------------------------------------
current_fpm_version() {
  # Read the version nginx is actually wired to, not what the env says.
  # -E for portability: macOS ships BSD sed, which lacks the GNU \+ operator.
  sed -nE 's|.*fastcgi_pass unix:.*/php([0-9]+)-fpm\.sock.*|\1|p' \
      "$BREW/etc/nginx/servers/local-dev.conf" 2>/dev/null | head -1
}

cmd_php() {
  local target="" site=""
  for a in "$@"; do
    case "$a" in
      --site=*) site="${a#--site=}" ;;
      -*)       bad "Unknown option: $a"; exit 1 ;;
      *)        target="$a" ;;
    esac
  done

  # No arguments: report.
  if [[ -z "$target" && -z "$site" ]]; then
    echo "PHP"
    echo "  default:  $(php_map_default | sed 's|^\(.\)|\1.|' 2>/dev/null || echo "$PHP_VERSION")  (serves every site without an override)"
    echo "  cli:      $(php -v 2>/dev/null | head -1 || echo 'not on PATH')"
    if [[ -f "$PHPMAP" ]]; then
      local overrides; overrides="$(grep -vE '^[[:space:]]*default[[:space:]]' "$PHPMAP" 2>/dev/null || true)"
      if [[ -n "$overrides" ]]; then
        echo
        echo "  Per-site overrides:"
        while IFS= read -r line; do
          [[ -n "$line" ]] || continue
          local k v
          k="$(awk '{print $1}' <<<"$line")"
          v="$(sed -nE 's|.*/php([0-9])([0-9]+)-fpm\.sock;.*|\1.\2|p' <<<"$line")"
          printf "    %-28s %s\n" "$k" "$v"
        done <<<"$overrides"
      fi
    fi
    echo
    echo "Installed:"
    brew list --formula 2>/dev/null | grep -E '^php(@[0-9.]+)?$' | sed 's/^/  /'
    echo
    echo "  devstack php 8.4                 change the default"
    echo "  devstack php 8.2 --site=legacy   pin one site"
    echo "  devstack php --site=legacy       remove that site's override"
    return 0
  fi

  # --site with no version: remove the override.
  if [[ -z "$target" && -n "$site" ]]; then
    [[ -d "$SITES_DIR/$site" ]] || { bad "No such site: $site"; exit 1; }
    php_map_remove "$site"
    ok "$site now uses the default PHP"
    warn "Reload nginx:  sudo nginx -s reload"
    return 0
  fi

  [[ "$target" =~ ^[0-9]+\.[0-9]+$ ]] || { bad "Version must look like 8.3 or 8.4"; exit 1; }
  php_prepare "$target" || exit 1

  if [[ -n "$site" ]]; then
    [[ -d "$SITES_DIR/$site" ]] || { bad "No such site: $site"; exit 1; }
    php_map_write "$site" "$target"
    ok "$site pinned to PHP $target"
  else
    php_map_write default "$target"
    ok "default PHP is now $target"
    # Keep the CLI aligned with the default; a mismatch resolves dependencies
    # against one version and runs them under another.
    brew unlink php >/dev/null 2>&1 || true
    local v
    for v in $(brew list --formula 2>/dev/null | grep -E '^php@[0-9.]+$'); do
      [[ "$v" == "php@$target" ]] || brew unlink "$v" >/dev/null 2>&1 || true
    done
    brew link --overwrite --force "php@$target" >/dev/null 2>&1 && ok "cli php linked to $target"
    php -m 2>/dev/null | grep -qi '^xdebug$' || warn "Xdebug is built per version — re-run: devstack install xdebug"
  fi
  warn "Reload nginx:  sudo nginx -s reload"
}

# --- mysql performance_schema ---------------------------------------------
cmd_mysql_perf() {
  local action="${1:-}" cnf="$BREW/etc/my.cnf"
  [[ -f "$cnf" ]] || { bad "No $cnf"; exit 1; }

  local state="ON (MySQL default)"
  grep -qE '^\s*performance_schema\s*=\s*OFF' "$cnf" && state="OFF"

  local live=""
  live="$(mysql -N -e "SHOW VARIABLES LIKE 'performance_schema'" 2>/dev/null | awk '{print $2}')"

  if [[ -z "$action" ]]; then
    echo "MySQL performance_schema"
    echo "  configured: $state"
    [[ -n "$live" ]] && echo "  running:    $live" || warn "MySQL not reachable — cannot read live value"
    local pid; pid="$(pgrep -x mysqld | head -1)"
    if [[ -n "$pid" ]] && command -v footprint >/dev/null 2>&1; then
      echo "  memory:     $(footprint -p "$pid" 2>/dev/null | grep -m1 'phys_footprint:' | grep -oE '[0-9.]+ [KMG]B')"
    fi
    echo
    echo "  ON  costs roughly 200 MB of pre-allocated memory, whether or not you query it."
    echo "  Toggle with:  devstack mysql perf on|off"
    return 0
  fi

  cp "$cnf" "$cnf.bak-$(date +%Y%m%d%H%M%S)"
  case "$action" in
    off)
      if grep -qE '^\s*#\s*performance_schema' "$cnf"; then
        /usr/bin/sed -i '' 's|^\s*#\s*performance_schema.*|performance_schema      = OFF|' "$cnf"
      elif ! grep -qE '^\s*performance_schema' "$cnf"; then
        printf '\nperformance_schema      = OFF\n' >> "$cnf"
      fi
      ok "performance_schema = OFF"
      ;;
    on)
      /usr/bin/sed -i '' 's|^\s*performance_schema\s*=\s*OFF.*|# performance_schema    = OFF  (enabled)|' "$cnf"
      ok "performance_schema enabled (MySQL default)"
      ;;
    *) bad "Use: devstack mysql perf on|off"; exit 1 ;;
  esac

  echo "Restarting MySQL…"
  brew services restart mysql >/dev/null
  # MySQL reports "started" before the socket is ready; poll rather than sleep.
  local i
  for i in $(seq 1 30); do mysql -N -e "SELECT 1" >/dev/null 2>&1 && break; sleep 1; done
  if mysql -N -e "SELECT 1" >/dev/null 2>&1; then
    ok "MySQL up (performance_schema = $(mysql -N -e "SHOW VARIABLES LIKE 'performance_schema'" 2>/dev/null | awk '{print $2}'))"
    local pid; pid="$(pgrep -x mysqld | head -1)"
    [[ -n "$pid" ]] && command -v footprint >/dev/null 2>&1 && \
      echo "  memory: $(footprint -p "$pid" 2>/dev/null | grep -m1 'phys_footprint:' | grep -oE '[0-9.]+ [KMG]B')"
  else
    bad "MySQL did not come back — check $cnf and its backup"
  fi
  [[ "$action" == "off" ]] && warn "performance_schema.* and information_schema.global_variables are now unavailable; use SHOW VARIABLES / SHOW STATUS"
  return 0
}

# --- one-time onboarding ---------------------------------------------------
CONFIG_DIR="$(dirname "$CONFIG_FILE")"

load_config() { [[ -f "$CONFIG_FILE" ]] && . "$CONFIG_FILE"; return 0; }

cmd_config() {
  if [[ "${1:-}" == "--show" ]]; then
    [[ -f "$CONFIG_FILE" ]] || { bad "Not configured yet. Run: devstack config"; exit 1; }
    echo "Configuration ($CONFIG_FILE)"
    sed 's/^/  /' "$CONFIG_FILE"
    return 0
  fi

  load_config
  echo "One-time setup. These become the admin account on every site you create."
  echo

  local name email user
  read -r -p "  Your name        [${ADMIN_NAME:-}]: " name;  name="${name:-${ADMIN_NAME:-}}"
  read -r -p "  Your email       [${ADMIN_EMAIL:-}]: " email; email="${email:-${ADMIN_EMAIL:-}}"
  read -r -p "  Admin username   [${ADMIN_USER:-admin}]: " user; user="${user:-${ADMIN_USER:-admin}}"

  [[ -n "$name" ]] || { bad "Name cannot be empty."; exit 1; }
  # WordPress rejects a malformed admin email outright, so check before we build a site.
  [[ "$email" =~ ^[^[:space:]@]+@[^[:space:]@]+\.[^[:space:]@]+$ ]] || { bad "That does not look like an email address."; exit 1; }
  [[ "$user" =~ ^[A-Za-z0-9_.-]+$ ]] || { bad "Username: letters, digits, dot, underscore, hyphen only."; exit 1; }

  mkdir -p "$CONFIG_DIR"
  # Rewrite the whole file, carrying the stack settings through — they are
  # written by install.sh and losing them would point the CLI at the wrong
  # sites directory and TLD.
  cat > "$CONFIG_FILE" <<EOF
# brew-dev-stack configuration.

# Stack layout (written by install.sh; environment variables still override).
SITES_DIR="$SITES_DIR"
TLD="$TLD"
PHP_VERSION="$PHP_VERSION"

# Used when creating new sites.
ADMIN_NAME="$name"
ADMIN_EMAIL="$email"
ADMIN_USER="$user"
EOF
  chmod 600 "$CONFIG_FILE"
  ok "Saved to $CONFIG_FILE"
  echo
  echo "  Create a site with:  devstack new myblog"
}

# --- new WordPress site ----------------------------------------------------
# Alphanumeric only: avoids quoting hazards in wp-config.php, SQL and shells.
site_db_name() { local n="${1//-/_}"; printf 'dev_%s' "${n:0:60}"; }

# Databases were prefixed wp_ before multiple project types existed.
site_db_candidates() { local n="${1//-/_}"; printf 'dev_%s\nwp_%s\n' "${n:0:60}" "${n:0:60}"; }

gen_password() {
  # No pipes: `tr ... | head -c N` makes head close the pipe early, SIGPIPEs tr,
  # and with `set -o pipefail` that aborts the whole script — intermittently,
  # since it depends on which process exits first.
  local s
  s="$(openssl rand -base64 48)"
  s="${s//[^A-Za-z0-9]/}"
  printf '%s' "${s:0:24}"
}

mysql_root() { mysql -u"${DB_ADMIN_USER:-root}" ${DB_ADMIN_PASS:+-p"$DB_ADMIN_PASS"} "$@"; }

cmd_new() {
  local site="${1:-}" type="wordpress"
  shift || true
  for a in "$@"; do
    case "$a" in
      --type=*) type="${a#--type=}" ;;
      *) bad "Unknown option: $a"; exit 1 ;;
    esac
  done
  [[ -n "$site" ]] || { bad "Usage: devstack new <sitename> [--type=wordpress|laravel|plain]"; exit 1; }
  case "$type" in wordpress|laravel|plain) ;; *) bad "Unknown type '$type'. Use wordpress, laravel or plain."; exit 1 ;; esac

  load_config
  [[ -n "${ADMIN_EMAIL:-}" ]] || { bad "Not configured. Run:  devstack config"; exit 1; }

  # Must be a valid DNS label, or it cannot appear in the certificate.
  [[ "$site" =~ ^[a-z0-9]([a-z0-9-]*[a-z0-9])?$ ]] || {
    bad "Site name must be lowercase letters, digits and hyphens (no spaces or underscores)."; exit 1; }

  case "$type" in
    wordpress) command -v wp >/dev/null || { bad "wp-cli not found:  brew install wp-cli"; exit 1; } ;;
    laravel)   command -v composer >/dev/null || { bad "composer not found:  brew install composer"; exit 1; } ;;
  esac
  mysql_root -N -e "SELECT 1" >/dev/null 2>&1 || { bad "Cannot connect to MySQL as ${DB_ADMIN_USER:-root}."; exit 1; }

  local dir="$SITES_DIR/$site"
  [[ -e "$dir" ]] && { bad "$dir already exists."; exit 1; }

  # MySQL identifiers cannot contain hyphens without quoting; normalise.
  local db; db="$(site_db_name "$site")"
  local dbuser="${db:0:32}"
  local dbpass adminpass url
  dbpass="$(gen_password)"
  adminpass="$(gen_password)"
  url="https://$site.$TLD"

  if grep -q . <<<"$(mysql_root -N -e "SHOW DATABASES LIKE '$db'" 2>/dev/null || true)"; then
    bad "Database '$db' already exists. Drop it or choose another name."; exit 1
  fi

  echo "Creating $site"
  mkdir -p "$dir"

  info_step() { printf '  \033[36m·\033[0m %s\n' "$*"; }

  info_step "database $db"
  mysql_root -e "CREATE DATABASE \`$db\` DEFAULT CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;"
  mysql_root -e "CREATE USER IF NOT EXISTS '$dbuser'@'127.0.0.1' IDENTIFIED BY '$dbpass';"
  mysql_root -e "GRANT ALL PRIVILEGES ON \`$db\`.* TO '$dbuser'@'127.0.0.1';"
  mysql_root -e "FLUSH PRIVILEGES;"

  case "$type" in

  wordpress)
    info_step "downloading WordPress"
    wp core download --path="$dir" --quiet

    info_step "wp-config.php"
    wp config create --path="$dir" --dbname="$db" --dbuser="$dbuser" --dbpass="$dbpass" \
       --dbhost=127.0.0.1 --skip-check --quiet \
       --extra-php <<'PHPEOF'
define( 'WP_DEBUG', true );
define( 'WP_DEBUG_LOG', true );
define( 'WP_DEBUG_DISPLAY', false );
define( 'WP_ENVIRONMENT_TYPE', 'local' );

/*
 * Follow whatever host the request arrived on.
 *
 * WordPress stores siteurl and home in the database. Reached through a tunnel,
 * it would otherwise emit asset URLs pointing at the .test hostname, which the
 * visitor cannot resolve — the page loads but every stylesheet and script 404s.
 * Deriving both from the request host makes the local name and any tunnel work
 * without touching the database.
 */
if ( ! empty( $_SERVER['HTTP_HOST'] ) ) {
    if ( ( $_SERVER['HTTP_X_FORWARDED_PROTO'] ?? '' ) === 'https' ) {
        $_SERVER['HTTPS'] = 'on';   // TLS was terminated upstream
    }
    $devstack_scheme = ( ! empty( $_SERVER['HTTPS'] ) && $_SERVER['HTTPS'] !== 'off' ) ? 'https' : 'http';
    define( 'WP_HOME',    $devstack_scheme . '://' . $_SERVER['HTTP_HOST'] );
    define( 'WP_SITEURL', $devstack_scheme . '://' . $_SERVER['HTTP_HOST'] );
}
PHPEOF

    info_step "installing WordPress"
    wp core install --path="$dir" --url="$url" --title="$site" \
       --admin_user="$ADMIN_USER" --admin_password="$adminpass" --admin_email="$ADMIN_EMAIL" \
       --skip-email --quiet
    wp option update blogdescription "Local development site" --path="$dir" --quiet 2>/dev/null || true
    wp rewrite structure '/%postname%/' --path="$dir" --quiet 2>/dev/null || true
    ;;

  laravel)
    info_step "composer create-project laravel/laravel (this takes a minute)"
    rmdir "$dir" 2>/dev/null || true   # composer wants to create it itself
    composer create-project laravel/laravel "$dir" --quiet --no-interaction

    info_step ".env"
    # Laravel ships APP_URL and a sqlite default; point both at this stack.
    /usr/bin/sed -i '' \
      -e "s|^APP_URL=.*|APP_URL=$url|" \
      -e "s|^APP_NAME=.*|APP_NAME=$site|" \
      -e "s|^DB_CONNECTION=.*|DB_CONNECTION=mysql|" \
      -e "s|^# *DB_HOST=.*|DB_HOST=127.0.0.1|" \
      -e "s|^# *DB_PORT=.*|DB_PORT=3306|" \
      -e "s|^# *DB_DATABASE=.*|DB_DATABASE=$db|" \
      -e "s|^# *DB_USERNAME=.*|DB_USERNAME=$dbuser|" \
      -e "s|^# *DB_PASSWORD=.*|DB_PASSWORD=$dbpass|" \
      -e "s|^DB_DATABASE=.*|DB_DATABASE=$db|" \
      -e "s|^DB_USERNAME=.*|DB_USERNAME=$dbuser|" \
      -e "s|^DB_PASSWORD=.*|DB_PASSWORD=$dbpass|" \
      "$dir/.env"

    # Point Laravel's mailer at Mailpit when it is running, so queued mail and
    # mailable previews are captured like everything else.
    if curl -sf --max-time 2 http://127.0.0.1:8025/readyz >/dev/null 2>&1; then
      /usr/bin/sed -i '' \
        -e "s|^MAIL_MAILER=.*|MAIL_MAILER=smtp|" \
        -e "s|^MAIL_HOST=.*|MAIL_HOST=127.0.0.1|" \
        -e "s|^MAIL_PORT=.*|MAIL_PORT=1025|" \
        -e "s|^MAIL_FROM_ADDRESS=.*|MAIL_FROM_ADDRESS=\"$site@$TLD\"|" \
        "$dir/.env"
      ok "mail routed to Mailpit"
    fi

    info_step "migrations"
    (cd "$dir" && php artisan migrate --force --quiet 2>/dev/null) \
      && ok "migrations ran" || warn "migrations failed — run: cd $dir && php artisan migrate"
    ;;

  plain)
    info_step "scaffolding"
    mkdir -p "$dir/public"
    cat > "$dir/public/index.php" <<PHPEOF
<?php
// $site — local development
echo "<h1>$site</h1>";
echo "<p>PHP " . PHP_VERSION . "</p>";
PHPEOF
    cat > "$dir/README.md" <<MDEOF
# $site

Served at $url from \`public/\`.

Database: \`$db\` (user \`$dbuser\`) — credentials are in this file only, so
move them somewhere your app reads before committing anything.

    DB_HOST=127.0.0.1
    DB_PORT=3306
    DB_DATABASE=$db
    DB_USERNAME=$dbuser
    DB_PASSWORD=$dbpass
MDEOF
    ;;
  esac

  info_step "certificate"
  SITES_DIR="$SITES_DIR" TLD="$TLD" "$(dirname "${BASH_SOURCE[0]}")/site-cert-regen" >/dev/null 2>&1 \
    && ok "certificate now covers $site.$TLD" || warn "certificate regeneration failed — run site-cert-regen"

  echo
  ok "$site created ($type)"
  echo
  echo "  URL       $url"
  if [[ "$type" == "wordpress" ]]; then
    echo "  Admin     $url/wp-admin"
    echo "  Username  $ADMIN_USER"
    echo "  Password  $adminpass"
  fi
  echo "  Database  $db   (user $dbuser)"
  echo
  case "$type" in
    wordpress) echo "  The admin password is shown once. Change it in Users → Profile, or:"
               echo "    wp user update $ADMIN_USER --user_pass='new-password' --path=$dir" ;;
    laravel)   echo "  Credentials are already written to $dir/.env" ;;
    plain)     echo "  Credentials are in $dir/README.md — move them into your app's config." ;;
  esac
  echo
  warn "Reload nginx so the new certificate is served:  sudo nginx -s reload"
}

# --- list ------------------------------------------------------------------
site_kind() {  # site_kind <dir> -> human label
  local d="$1"
  if   [[ -f "$d/wp-config.php" || -f "$d/wp-load.php" ]]; then echo "WordPress"
  elif [[ -f "$d/artisan" ]]; then echo "Laravel"
  elif [[ -f "$d/bin/console" ]]; then echo "Symfony"
  elif [[ -f "$d/composer.json" ]]; then echo "PHP (composer)"
  elif [[ -f "$d/index.php" || -f "$d/public/index.php" ]]; then echo "PHP"
  elif [[ -f "$d/index.html" || -f "$d/public/index.html" ]]; then echo "static"
  else echo "-"; fi
}

site_repo() {  # site_repo <dir> -> owner/name, or "-"
  local d="$1" url top
  # Only report a repo rooted at this directory. Without this, a symlinked site
  # (e.g. phpmyadmin -> /opt/homebrew/share/phpmyadmin) walks up and reports
  # Homebrew's own repository.
  top="$(git -C "$d" rev-parse --show-toplevel 2>/dev/null)" || { echo "-"; return; }
  [[ "$(cd "$d" && pwd -P)" == "$(cd "$top" && pwd -P)" ]] || { echo "-"; return; }
  url="$(git -C "$d" remote get-url origin 2>/dev/null)" || { echo "-"; return; }
  # git@host:owner/name.git  or  https://host/owner/name.git
  url="${url%.git}"; url="${url##*:}"; url="${url#//}"
  case "$url" in */*/*) echo "${url#*/}" ;; *) echo "${url##*/}" ;; esac
}

cmd_list() {
  local rows; rows="$(mktemp)"
  local n=0 served=0 d name kind repo docroot url link
  for d in "$SITES_DIR"/*/; do
    [[ -d "$d" ]] || continue
    name="$(basename "$d")"
    kind="$(site_kind "${d%/}")"
    repo="$(site_repo "${d%/}")"
    docroot="root"; [[ -d "${d%/}/public" ]] && docroot="public"
    link="false"; [[ -L "${d%/}" ]] && link="true"
    n=$((n+1))
    if grep -qE '^[a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?$' <<<"$name"; then
      url="https://$name.$TLD"; served=$((served+1))
    else
      url=""
    fi
    printf '%s%s%s%s%s%s%s%s%s%s%s%s%s\n' \
      "$name" "$SEP" "$kind" "$SEP" "$docroot" "$SEP" "$repo" "$SEP" \
      "$url" "$SEP" "${d%/}" "$SEP" "$link" >> "$rows"
  done

  if (( JSON )); then
    json_rows_to_array 'name,type,docroot,repo,url,path,symlink' < "$rows"
    rm -f "$rows"; return 0
  fi

  printf '  %-24s %-15s %-8s %-28s %s\n' "SITE" "TYPE" "DOCROOT" "REPO" "URL"
  printf '  %-24s %-15s %-8s %-28s %s\n' "----" "----" "-------" "----" "---"
  while IFS="$SEP" read -r name kind docroot repo url path link; do
    local mark=""; [[ "$link" == "true" ]] && mark=" →link"
    local shown="$url"; [[ -z "$url" ]] && shown="(name not a valid hostname — not served)"
    local dr="root"; [[ "$docroot" == "public" ]] && dr="public/"
    printf '  %-24s %-15s %-8s %-28s %s%s\n' "${name:0:24}" "$kind" "$dr" "${repo:0:28}" "$shown" "$mark"
  done < "$rows"
  rm -f "$rows"
  echo
  echo "  $n directories, $served served"
}

# --- rm --------------------------------------------------------------------
cmd_rm() {
  local site="${1:-}" keep_db=0 keep_files=0
  shift || true
  for a in "$@"; do
    case "$a" in
      --keep-db)    keep_db=1 ;;
      --keep-files) keep_files=1 ;;
      *) bad "Unknown option: $a"; exit 1 ;;
    esac
  done
  [[ -n "$site" ]] || { bad "Usage: devstack rm <sitename> [--keep-db] [--keep-files]"; exit 1; }

  local dir="$SITES_DIR/$site"
  [[ -e "$dir" ]] || { bad "No such site: $dir"; exit 1; }

  local db="" dbuser db_exists=0 cand
  while IFS= read -r cand; do
    if grep -q . <<<"$(mysql_root -N -e "SHOW DATABASES LIKE '$cand'" 2>/dev/null || true)"; then
      db="$cand"; db_exists=1; break
    fi
  done < <(site_db_candidates "$site")
  [[ -z "$db" ]] && db="$(site_db_name "$site")"
  dbuser="${db:0:32}"

  echo "About to remove:"
  [[ "$keep_files" == "0" ]] && echo "  files     $dir  ($(du -sh "$dir" 2>/dev/null | cut -f1))" \
                             || echo "  files     kept (--keep-files)"
  if [[ "$db_exists" == "1" && "$keep_db" == "0" ]]; then
    echo "  database  $db  ($(mysql_root -N -e "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='$db'" 2>/dev/null) tables)"
    echo "  db user   $dbuser@127.0.0.1"
  elif [[ "$db_exists" == "1" ]]; then
    echo "  database  $db  kept (--keep-db)"
  else
    echo "  database  none found named $db"
  fi

  # Uncommitted work is the one thing that cannot be recovered afterwards.
  if git -C "$dir" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    local dirty; dirty="$(git -C "$dir" status --porcelain 2>/dev/null | wc -l | tr -d ' ')"
    [[ "$dirty" != "0" ]] && warn "$dirty uncommitted change(s) in this git repo"
    local unpushed; unpushed="$(git -C "$dir" log --branches --not --remotes --oneline 2>/dev/null | wc -l | tr -d ' ')"
    [[ "$unpushed" != "0" ]] && warn "$unpushed unpushed commit(s)"
  fi

  echo
  echo "This cannot be undone. Type the site name to confirm:"
  local answer; read -r -p "  > " answer
  [[ "$answer" == "$site" ]] || { echo "  Names did not match. Aborted."; exit 0; }

  if [[ "$db_exists" == "1" && "$keep_db" == "0" ]]; then
    mysql_root -e "DROP DATABASE \`$db\`;" && ok "dropped $db"
    mysql_root -e "DROP USER IF EXISTS '$dbuser'@'127.0.0.1';" && ok "dropped user $dbuser"
  fi
  if [[ "$keep_files" == "0" ]]; then
    rm -rf "$dir" && ok "removed $dir"
  fi

  SITES_DIR="$SITES_DIR" TLD="$TLD" "$(dirname "${BASH_SOURCE[0]}")/site-cert-regen" >/dev/null 2>&1 \
    && ok "certificate regenerated" || warn "certificate regeneration failed"
  warn "Reload nginx:  sudo nginx -s reload"
}

# --- adminer (MySQL + PostgreSQL + SQLite in one PHP file) -----------------
cmd_adminer() {
  local dir="$SITES_DIR/adminer" url="https://www.adminer.org/latest.php"
  local tmp; tmp="$(mktemp -t adminer)"

  echo "Adminer — one PHP file, administers MySQL, PostgreSQL and SQLite."
  echo "  source: $url"
  echo "  target: $dir/index.php"
  echo

  if ! curl -fsSL --max-time 60 -o "$tmp" "$url"; then
    rm -f "$tmp"; bad "Download failed."; exit 1
  fi
  # A truncated download or an error page would otherwise be served as a site.
  if ! grep -q '<?php' <<<"$(head -c 20 "$tmp" 2>/dev/null || true)"; then
    rm -f "$tmp"; bad "Downloaded file is not PHP — refusing to install it."; exit 1
  fi
  local size; size="$(wc -c < "$tmp" | tr -d ' ')"
  (( size > 100000 )) || { rm -f "$tmp"; bad "File is only ${size}B — suspiciously small."; exit 1; }

  mkdir -p "$dir"
  mv "$tmp" "$dir/index.php"
  chmod 644 "$dir/index.php"
  ok "installed ($(( size / 1024 )) KB)"

  SITES_DIR="$SITES_DIR" TLD="$TLD" "$(dirname "${BASH_SOURCE[0]}")/site-cert-regen" >/dev/null 2>&1 \
    && ok "certificate now covers adminer.$TLD" || warn "run site-cert-regen"

  cat <<EOF

  https://adminer.$TLD

  MySQL        system: MySQL       server: 127.0.0.1        user: root   (no password)
  PostgreSQL   system: PostgreSQL  server: 127.0.0.1:5432   user: $USER

EOF
  warn "Reload nginx:  sudo nginx -s reload"
}

# --- mailpit ---------------------------------------------------------------
cmd_install_mailpit() {
  local plist="$HOME/Library/LaunchAgents/dev.brewdevstack.mailpit.plist"
  local ini="$BREW/etc/php/$PHP_VERSION/conf.d/zz-mailpit.ini"
  local vhost="$BREW/etc/nginx/servers/mailpit.conf"
  local tpl; tpl="$(dirname "${BASH_SOURCE[0]}")/../config/mailpit.conf.template"

  brew list --versions mailpit >/dev/null 2>&1 || { echo "Installing mailpit…"; brew install mailpit >/dev/null; }
  ok "mailpit $(brew list --versions mailpit | awk '{print $2}')"

  # Homebrew's own service passes no arguments, so mailpit would listen on all
  # interfaces — and captured mail contains password-reset links. Brew rewrites
  # its plist on every services call, so the flags cannot live there.
  brew services stop mailpit >/dev/null 2>&1 || true
  cat > "$plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>dev.brewdevstack.mailpit</string>
  <key>ProgramArguments</key>
  <array>
    <string>$BREW/opt/mailpit/bin/mailpit</string>
    <string>--listen</string><string>127.0.0.1:8025</string>
    <string>--smtp</string><string>127.0.0.1:1025</string>
    <string>--max</string><string>2000</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>$BREW/var/log/mailpit.log</string>
  <key>StandardErrorPath</key><string>$BREW/var/log/mailpit.log</string>
  <key>ProcessType</key><string>Background</string>
</dict>
</plist>
EOF
  # bootout is not synchronous: bootstrapping immediately after can fail with
  # "Bootstrap failed: 5". Wait for it to unload, then retry the bootstrap.
  local i
  launchctl bootout gui/"$(id -u)"/dev.brewdevstack.mailpit 2>/dev/null || true
  for i in $(seq 1 10); do
    grep -q dev.brewdevstack.mailpit <<<"$(out_of launchctl list)" || break
    sleep 1
  done
  launchctl enable gui/"$(id -u)"/dev.brewdevstack.mailpit 2>/dev/null || true
  for i in 1 2 3; do
    launchctl bootstrap gui/"$(id -u)" "$plist" 2>/dev/null && break
    sleep 2
  done

  # Never report success without proving it: a stale process answering readyz
  # would otherwise mask a failed bootstrap.
  grep -q dev.brewdevstack.mailpit <<<"$(out_of launchctl list)" \
    || { bad "mailpit agent failed to load"; return 1; }
  for i in $(seq 1 20); do curl -sf --max-time 2 http://127.0.0.1:8025/readyz >/dev/null 2>&1 && break; sleep 1; done
  if curl -sf --max-time 3 http://127.0.0.1:8025/readyz >/dev/null 2>&1; then
    ok "running on 127.0.0.1:1025 (smtp) and :8025 (ui)"
  else
    bad "mailpit did not come up — see $BREW/var/log/mailpit.log"; return 1
  fi

  # One setting catches every PHP application, WordPress included — no plugin.
  mkdir -p "$(dirname "$ini")"
  cat > "$ini" <<EOF
; Route all PHP mail() through Mailpit instead of the system MTA.
; Otherwise mail() hands off to postfix, which attempts real MX delivery: a
; local test site can email a real person, and you cannot see what was sent.
sendmail_path = "$BREW/opt/mailpit/bin/mailpit sendmail -S 127.0.0.1:1025"
EOF
  brew services restart "php@$PHP_VERSION" >/dev/null 2>&1
  ok "php mail() routed to mailpit"

  if [[ -f "$tpl" ]]; then
    sed -e "s|{{BREW}}|$BREW|g" -e "s|{{TLD}}|$TLD|g" "$tpl" > "$vhost"
    ok "vhost → https://mailpit.$TLD"
  fi

  SITES_DIR="$SITES_DIR" TLD="$TLD" "$(dirname "${BASH_SOURCE[0]}")/site-cert-regen" >/dev/null 2>&1 \
    && ok "certificate covers mailpit.$TLD"
  echo
  warn "Reload nginx:  sudo nginx -s reload"
}

# --- xdebug ----------------------------------------------------------------
cmd_install_xdebug() {
  local ini="$BREW/etc/php/$PHP_VERSION/conf.d/zz-xdebug.ini"
  local extdir; extdir="$(php -i 2>/dev/null | sed -nE 's/^extension_dir => ([^ ]+) .*/\1/p' | head -1)"

  command -v pecl >/dev/null || { bad "pecl not found — it ships with php@$PHP_VERSION"; return 1; }
  xcode-select -p >/dev/null 2>&1 || { bad "Xcode command line tools required:  xcode-select --install"; return 1; }

  if [[ -f "$extdir/xdebug.so" ]]; then
    ok "xdebug.so already built for PHP $PHP_VERSION"
  else
    echo "Compiling Xdebug for PHP $PHP_VERSION (a minute or two)…"
    # Xdebug is not in Homebrew core, so this is a pecl build. That means it is
    # tied to one PHP version and must be rebuilt when you switch versions —
    # `devstack php <ver>` reminds you.
    pecl install xdebug >/dev/null 2>&1 || pecl install --force xdebug >/dev/null 2>&1
    [[ -f "$extdir/xdebug.so" ]] || { bad "build failed — run 'pecl install xdebug' to see why"; return 1; }
    ok "built $extdir/xdebug.so"
  fi

  # pecl appends a bare "extension=xdebug.so" to php.ini, which is wrong for a
  # Zend extension and can load it twice. Remove that and configure properly.
  local phpini="$BREW/etc/php/$PHP_VERSION/php.ini"
  if grep -qE '^\s*(zend_)?extension\s*=\s*"?xdebug' "$phpini" 2>/dev/null; then
    /usr/bin/sed -i '' -E '/^[[:space:]]*(zend_)?extension[[:space:]]*=[[:space:]]*"?xdebug/d' "$phpini"
    ok "removed pecl's duplicate extension line from php.ini"
  fi

  cat > "$ini" <<EOF
; Xdebug — must be loaded as a Zend extension, not a plain one.
zend_extension = "$extdir/xdebug.so"

; Dormant until asked. Always-on step debugging slows every request
; noticeably, so trigger it per request instead:
;   browser  — an Xdebug helper extension, or ?XDEBUG_TRIGGER=1
;   cli      — XDEBUG_TRIGGER=1 php script.php
xdebug.mode = debug,develop
xdebug.start_with_request = trigger
xdebug.client_host = 127.0.0.1
xdebug.client_port = 9003
xdebug.idekey = VSCODE
xdebug.log_level = 0

; develop mode gives readable stack traces and var_dump output.
xdebug.max_nesting_level = 512

; Profiling and coverage are opt-in via mode; uncomment when needed.
; xdebug.mode = profile
; xdebug.output_dir = $BREW/var/log/xdebug
EOF
  mkdir -p "$BREW/var/log/xdebug"
  brew services restart "php@$PHP_VERSION" >/dev/null 2>&1

  local i
  for i in $(seq 1 15); do grep -qi '^xdebug$' <<<"$(out_of php -m)" && break; sleep 1; done
  if grep -qi '^xdebug$' <<<"$(out_of php -m)"; then
    ok "xdebug $(php -r 'echo phpversion("xdebug");' 2>/dev/null) loaded (mode: $(php -r 'echo ini_get("xdebug.mode");' 2>/dev/null))"
  else
    bad "xdebug did not load — check $ini"; return 1
  fi

  cat <<EOF

  Step debugging listens on port 9003. Start your IDE listener, then trigger a
  request with ?XDEBUG_TRIGGER=1 (or an Xdebug browser helper).

  VS Code launch.json:
    { "name": "Listen for Xdebug", "type": "php", "request": "launch", "port": 9003 }

  PhpStorm: Run > Start Listening for PHP Debug Connections.

EOF
  warn "Xdebug is built per PHP version — re-run this after 'devstack php <ver>'"
}

# --- redis -----------------------------------------------------------------
cmd_install_redis() {
  brew list --versions redis >/dev/null 2>&1 || { echo "Installing redis…"; brew install redis >/dev/null; }
  ok "redis $(brew list --versions redis | awk '{print $2}')"

  # Brew's redis.conf already binds to 127.0.0.1, but make it explicit — this
  # holds sessions and cache for every local site.
  local rconf="$BREW/etc/redis.conf"
  if [[ -f "$rconf" ]] && ! grep -qE '^bind 127\.0\.0\.1' "$rconf"; then
    cp "$rconf" "$rconf.bak-$(date +%Y%m%d%H%M%S)"
    /usr/bin/sed -i '' -e 's|^bind .*|bind 127.0.0.1 ::1|' "$rconf"
    ok "bound to 127.0.0.1"
  fi

  brew services restart redis >/dev/null 2>&1
  local i
  for i in $(seq 1 20); do redis-cli ping >/dev/null 2>&1 && break; sleep 1; done
  if [[ "$(redis-cli ping 2>/dev/null)" == "PONG" ]]; then
    ok "redis responding on 127.0.0.1:6379"
  else
    bad "redis did not come up — see $BREW/var/log/redis.log"; return 1
  fi

  # PHP needs the phpredis extension to talk to it. Laravel can fall back to
  # the pure-PHP predis package, but WordPress object-cache plugins require this.
  local extdir; extdir="$(php -i 2>/dev/null | sed -nE 's/^extension_dir => ([^ ]+) .*/\1/p' | head -1)"
  if [[ -f "$extdir/redis.so" ]]; then
    ok "phpredis already built for PHP $PHP_VERSION"
  else
    command -v pecl >/dev/null || { warn "pecl not found — skipping the PHP extension"; return 0; }
    echo "Compiling phpredis for PHP $PHP_VERSION…"
    # phpredis asks about optional deps; answer with defaults.
    printf 'no\nno\nno\nno\n' | pecl install redis >/dev/null 2>&1 || pecl install --force redis >/dev/null 2>&1
    [[ -f "$extdir/redis.so" ]] || { warn "phpredis build failed — run 'pecl install redis' to see why"; return 0; }
    ok "built $extdir/redis.so"
  fi

  # pecl appends extension=redis.so to php.ini; own it in conf.d instead.
  local phpini="$BREW/etc/php/$PHP_VERSION/php.ini"
  grep -qE '^\s*extension\s*=\s*"?redis' "$phpini" 2>/dev/null && \
    /usr/bin/sed -i '' -E '/^[[:space:]]*extension[[:space:]]*=[[:space:]]*"?redis/d' "$phpini"
  printf 'extension = "%s/redis.so"\n' "$extdir" > "$BREW/etc/php/$PHP_VERSION/conf.d/zz-redis.ini"
  brew services restart "php@$PHP_VERSION" >/dev/null 2>&1
  for i in $(seq 1 15); do grep -qi '^redis$' <<<"$(out_of php -m)" && break; sleep 1; done
  grep -qi '^redis$' <<<"$(out_of php -m)" \
    && ok "php redis extension loaded" || warn "php redis extension did not load"

  cat <<EOF

  Laravel .env:
    REDIS_HOST=127.0.0.1
    REDIS_PORT=6379
    CACHE_STORE=redis   SESSION_DRIVER=redis   QUEUE_CONNECTION=redis

  WordPress: install a Redis object cache plugin; defaults (127.0.0.1:6379) work.
  Use a different database number per site to keep them apart: REDIS_DB=0,1,2…

EOF
}

# --- public tunnel ---------------------------------------------------------
cmd_tunnel() {
  local site="${1:-}"
  [[ -n "$site" ]] || { bad "Usage: devstack tunnel <sitename>"; exit 1; }
  [[ -d "$SITES_DIR/$site" ]] || { bad "No such site: $site"; exit 1; }

  command -v cloudflared >/dev/null || { echo "Installing cloudflared…"; brew install cloudflared >/dev/null; }

  local target="$BREW/etc/nginx/tunnel-target.conf"
  [[ -f "$BREW/etc/nginx/servers/zz-tunnel.conf" ]] || {
    bad "Tunnel vhost missing — re-run install.sh, or copy config/tunnel.conf.template"; exit 1; }

  local docroot="$SITES_DIR/$site"
  [[ -d "$docroot/public" ]] && docroot="$docroot/public"
  local sock; sock="$(php_sock "$PHP_VERSION")"
  local pinned
  pinned="$(sed -nE "s|^[[:space:]]*${site}[[:space:]]+.*/php([0-9])([0-9]+)-fpm\.sock;.*|\1.\2|p" "$PHPMAP" 2>/dev/null | head -1)"
  [[ -n "$pinned" ]] && sock="$(php_sock "$pinned")"

  # A WordPress site created before host-following URLs existed still has
  # siteurl/home pinned in the database. Say so now rather than letting the
  # user meet an unstyled page and wonder what the tunnel broke.
  local wpconf="$SITES_DIR/$site/wp-config.php"
  if [[ -f "$wpconf" ]] && ! grep -q "WP_SITEURL" "$wpconf" 2>/dev/null; then
    warn "$site pins its URL in the database — CSS and JS will 404 over the tunnel."
    echo "       Add this to $wpconf, above the 'stop editing' line:"
    cat <<'SNIP'

         if ( ! empty( $_SERVER['HTTP_HOST'] ) ) {
             if ( ( $_SERVER['HTTP_X_FORWARDED_PROTO'] ?? '' ) === 'https' ) { $_SERVER['HTTPS'] = 'on'; }
             $s = ( ! empty( $_SERVER['HTTPS'] ) && $_SERVER['HTTPS'] !== 'off' ) ? 'https' : 'http';
             define( 'WP_HOME',    $s . '://' . $_SERVER['HTTP_HOST'] );
             define( 'WP_SITEURL', $s . '://' . $_SERVER['HTTP_HOST'] );
         }

SNIP
    printf '       Continue anyway? [y/N] '
    local answer; read -r answer
    [[ "$answer" =~ ^[Yy]$ ]] || { echo "  Aborted."; exit 0; }
  fi

  # Laravel reads APP_URL for generated links; warn if it is pinned to .test.
  if [[ -f "$SITES_DIR/$site/.env" ]] && grep -q "^APP_URL=.*\.$TLD" "$SITES_DIR/$site/.env" 2>/dev/null; then
    warn "APP_URL in .env points at .$TLD — absolute links will use it."
    echo "       Laravel builds most URLs from the request, so this usually only"
    echo "       affects mail and queued jobs. Set APP_URL to the tunnel address"
    echo "       if you are testing those."
  fi

  printf 'set $t_root "%s";\nset $t_sock "%s";\n' "$docroot" "$sock" > "$target"

  # Rewrite the local hostname out of every response body. Order matters: the
  # scheme'd forms are consumed first, so the bare protocol-relative rule only
  # catches what is left. WordPress emits //site.test for dns-prefetch hints,
  # which a rule for http:// and https:// alone would miss.
  {
    printf 'sub_filter "http://%s.%s"  "https://$host";\n'  "$site" "$TLD"
    printf 'sub_filter "https://%s.%s" "https://$host";\n'  "$site" "$TLD"
    printf 'sub_filter "//%s.%s"       "//$host";\n'        "$site" "$TLD"
  } > "$BREW/etc/nginx/tunnel-subs.conf"

  cat <<EOF

  Tunnelling $site  ($docroot)

  This makes the site reachable from the internet by anyone with the URL.
  A quick tunnel: random trycloudflare.com address, no account, gone on ctrl-c.
  Local sites often run with no credentials — do not tunnel anything private.

  nginx needs one reload to pick up the target (it will ask for your password).

EOF
  sudo nginx -s reload || { bad "reload failed"; exit 1; }

  # Point the vhost back at nothing when the tunnel ends, so a stale target is
  # not left serving a site to any future tunnel.
  cleanup_tunnel() {
    printf 'set $t_root "/var/empty";\nset $t_sock "/dev/null";\n' > "$target"
    printf 'sub_filter "http://placeholder.invalid" "https://$host";\n' > "$BREW/etc/nginx/tunnel-subs.conf"
    sudo nginx -s reload 2>/dev/null || true
    echo; echo "  Tunnel closed, vhost reset."
  }
  trap cleanup_tunnel EXIT INT TERM

  # No --http-host-header: the app must see the real public hostname, otherwise
  # WordPress and Laravel emit asset URLs for the .test name and the page loads
  # unstyled. The vhost matches *.trycloudflare.com instead.
  cloudflared tunnel --url "http://127.0.0.1:80" --no-autoupdate
}


# --- laravel workers -------------------------------------------------------
worker_label() { printf 'dev.brewdevstack.%s.%s' "$2" "$1"; }   # <kind> <site>

worker_plist() {  # <kind> <site> <args...>
  local kind="$1" site="$2"; shift 2
  local label; label="$(worker_label "$kind" "$site")"
  local dir="$SITES_DIR/$site"
  local file="$HOME/Library/LaunchAgents/$label.plist"
  local php_bin="$BREW/opt/php@$PHP_VERSION/bin/php"
  # Honour a per-site PHP pin so the worker runs the same version as the web.
  local pinned
  pinned="$(sed -nE "s|^[[:space:]]*${site}[[:space:]]+.*/php([0-9])([0-9]+)-fpm\.sock;.*|\1.\2|p" "$PHPMAP" 2>/dev/null | head -1)"
  [[ -n "$pinned" ]] && php_bin="$BREW/opt/php@$pinned/bin/php"

  local extra=""
  local a
  for a in "$@"; do extra+="    <string>$a</string>"$'\n'; done

  local interval=""
  [[ "$kind" == "schedule" ]] && interval="  <key>StartInterval</key><integer>60</integer>"
  local keepalive="  <key>KeepAlive</key><true/>"
  [[ "$kind" == "schedule" ]] && keepalive="  <key>KeepAlive</key><false/>"

  cat > "$file" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$label</string>
  <key>ProgramArguments</key>
  <array>
    <string>$php_bin</string>
    <string>artisan</string>
$extra  </array>
  <key>WorkingDirectory</key><string>$dir</string>
  <key>RunAtLoad</key><true/>
$keepalive
$interval
  <key>StandardOutPath</key><string>$dir/storage/logs/devstack-$kind.log</string>
  <key>StandardErrorPath</key><string>$dir/storage/logs/devstack-$kind.log</string>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>ProcessType</key><string>Background</string>
</dict>
</plist>
EOF
  printf '%s' "$file"
}

worker_toggle() {  # <kind> <site> <on|off>
  local kind="$1" site="$2" action="${3:-}"
  local label; label="$(worker_label "$kind" "$site")"
  local file="$HOME/Library/LaunchAgents/$label.plist"

  [[ -d "$SITES_DIR/$site" ]] || { bad "No such site: $site"; exit 1; }
  [[ -f "$SITES_DIR/$site/artisan" ]] || { bad "$site is not a Laravel project (no artisan)"; exit 1; }

  if [[ -z "$action" ]]; then
    if grep -q "$label" <<<"$(out_of launchctl list)"; then
      ok "$kind worker running for $site"
      echo "  log: $SITES_DIR/$site/storage/logs/devstack-$kind.log"
    else
      warn "$kind worker not running for $site"
      echo "  start it:  devstack $kind $site on"
    fi
    return 0
  fi

  case "$action" in
    on)
      mkdir -p "$SITES_DIR/$site/storage/logs"
      if [[ "$kind" == "queue" ]]; then
        # --max-time recycles the worker hourly so code changes are picked up;
        # a long-lived queue worker otherwise runs stale code indefinitely.
        worker_plist queue "$site" queue:work --tries=3 --max-time=3600 >/dev/null
      else
        worker_plist schedule "$site" schedule:run >/dev/null
      fi
      launchctl bootout "gui/$(id -u)/$label" 2>/dev/null || true
      local i
      for i in $(seq 1 10); do grep -q "$label" <<<"$(out_of launchctl list)" || break; sleep 1; done
      launchctl enable "gui/$(id -u)/$label" 2>/dev/null || true
      for i in 1 2 3; do launchctl bootstrap "gui/$(id -u)" "$file" 2>/dev/null && break; sleep 2; done
      sleep 2
      grep -q "$label" <<<"$(out_of launchctl list)" \
        && ok "$kind worker started for $site" \
        || { bad "failed to start — see $SITES_DIR/$site/storage/logs/devstack-$kind.log"; return 1; }
      ;;
    off)
      launchctl bootout "gui/$(id -u)/$label" 2>/dev/null || true
      rm -f "$file"
      ok "$kind worker stopped for $site"
      ;;
    *) bad "Use: devstack $kind $site on|off"; exit 1 ;;
  esac
}

# --- json output -----------------------------------------------------------
# Hand-rolled JSON in shell gets escaping wrong sooner or later, and PHP is
# guaranteed present here. Collect rows as tab-separated fields, then convert
# once — a single process regardless of how many rows.
JSON=0
# Tab is IFS whitespace, so `IFS=$'\t' read` collapses consecutive tabs and
# silently drops empty fields, shifting every later column. ASCII Unit
# Separator is not whitespace, so empty fields survive.
SEP=$'\x1f'

json_rows_to_array() {  # json_rows_to_array <field,field,...> < rows.tsv
  php -r '
    $fields = explode(",", $argv[1]);
    $out = [];
    while (($line = fgets(STDIN)) !== false) {
      $line = rtrim($line, "\n");
      if ($line === "") continue;
      $vals = explode("\x1f", $line);
      $row = [];
      foreach ($fields as $i => $f) {
        $v = $vals[$i] ?? "";
        if ($v === "true" || $v === "false") { $row[$f] = ($v === "true"); }
        elseif ($v !== "" && ctype_digit($v))  { $row[$f] = (int) $v; }
        else                                   { $row[$f] = $v; }
      }
      $out[] = $row;
    }
    echo json_encode($out, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES), "\n";
  ' -- "$1"
}

json_object() {  # json_object key value key value …
  php -r '
    $a = array_slice($argv, 1);
    $o = [];
    for ($i = 0; $i < count($a); $i += 2) {
      $k = $a[$i]; $v = $a[$i + 1] ?? "";
      if ($v === "true" || $v === "false") { $o[$k] = ($v === "true"); }
      elseif ($v !== "" && ctype_digit($v))  { $o[$k] = (int) $v; }
      elseif (str_starts_with($v, "[") || str_starts_with($v, "{")) {
        $d = json_decode($v, true);
        $o[$k] = $d === null ? $v : $d;      // already-encoded fragment
      } else { $o[$k] = $v; }
    }
    echo json_encode($o, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES), "\n";
  ' -- "$@"
}

VERSION="0.1.0"

cmd_mysql() {
case "${1:-}" in
    perf) shift; cmd_mysql_perf "${1:-}" ;;
    "")   bad "Usage: devstack mysql perf [on|off]"; exit 1 ;;
    *)    bad "Unknown mysql subcommand: $1"; exit 1 ;;
  esac
}

cmd_install() {
  case "${1:-}" in
    adminer) cmd_adminer ;;
    mailpit) cmd_install_mailpit ;;
    xdebug)  cmd_install_xdebug ;;
    redis)   cmd_install_redis ;;
    "")      bad "Usage: devstack install <adminer|mailpit|xdebug|redis>"; exit 1 ;;
    *)       bad "Nothing to install called '$1'. Available: adminer, mailpit, xdebug, redis"; exit 1 ;;
  esac
}

# --json is global: accept it anywhere in the arguments and strip it before
# the command sees them.
_args=()
for _a in "$@"; do
  case "$_a" in
    --json) JSON=1 ;;
    *) _args+=("$_a") ;;
  esac
done
set -- "${_args[@]+"${_args[@]}"}"

case "${1:-}" in
  new)     shift; cmd_new "$@" ;;
  list)    cmd_list ;;
  rm)      shift; cmd_rm "$@" ;;
  tunnel)  shift; cmd_tunnel "${1:-}" ;;
  queue)   shift; worker_toggle queue "${1:-}" "${2:-}" ;;
  schedule) shift; worker_toggle schedule "${1:-}" "${2:-}" ;;
  status)  cmd_status ;;
  doctor)  cmd_doctor ;;
  start)   cmd_start ;;
  stop)    cmd_stop ;;
  reload)  cmd_reload ;;
  logs)    shift; cmd_logs "${1:-}" ;;
  config)  shift; cmd_config "${1:-}" ;;
  php)     shift; cmd_php "$@" ;;
  mysql)   shift; cmd_mysql "$@" ;;
  install) shift; cmd_install "$@" ;;
  help|-h|--help) usage ;;
  --version|-V) echo "devstack $VERSION" ;;
  "")      usage; exit 1 ;;
  # Renamed in 0.1.0; tell people rather than printing generic usage.
  mysql-perf) bad "Renamed:  devstack mysql perf ${2:-[on|off]}"; exit 1 ;;
  adminer)    bad "Renamed:  devstack install adminer"; exit 1 ;;
  *)       bad "Unknown command: $1"; echo; usage; exit 1 ;;
esac
