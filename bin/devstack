#!/usr/bin/env bash
#
# devstack — start/stop/status helper for brew-dev-stack.
#
set -euo pipefail

TLD="${TLD:-test}"
PHP_VERSION="${PHP_VERSION:-8.3}"
SITES_DIR="${SITES_DIR:-$HOME/sites}"
BREW="$(brew --prefix)"
PHPSHORT="${PHP_VERSION//./}"

ok()   { printf '  \033[32m✓\033[0m %s\n' "$*"; }
bad()  { printf '  \033[31m✗\033[0m %s\n' "$*"; }
warn() { printf '  \033[33m!\033[0m %s\n' "$*"; }

usage() {
  cat <<EOF
Usage: devstack <command>

  status     show what is running and whether the stack answers
  php [ver]  show the active PHP version, or switch to it (e.g. devstack php 8.4)
  mysql-perf [on|off]
             show or toggle MySQL performance_schema (~200 MB when ON)
  start      start php-fpm, dnsmasq, nginx (the last two need sudo)
  stop       stop them
  reload     regenerate the certificate and reload nginx
  logs       tail the nginx error log
  doctor     diagnose the usual failure modes
EOF
}

cmd_status() {
  echo "Services"
  for s in "php@$PHP_VERSION" mysql postgresql@16; do
    if brew services list 2>/dev/null | grep -qE "^${s//./\\.} +started"; then ok "$s"; else warn "$s not started"; fi
  done
  # nginx rewrites its argv to "nginx: master process …", so `pgrep -x nginx`
  # finds nothing even while it is serving. Match the master line instead.
  pgrep -f 'nginx: master' >/dev/null && ok "nginx running" || bad "nginx not running"
  pgrep -f "$BREW/opt/dnsmasq" >/dev/null && ok "dnsmasq running" || bad "dnsmasq not running"

  echo
  echo "Listeners"
  lsof -nP -iTCP:80 -iTCP:443 -sTCP:LISTEN 2>/dev/null | awk '/LISTEN/{print "  "$1, $9}' | sort -u || warn "nothing on 80/443"

  echo
  echo "PHP socket"
  [[ -S "$BREW/var/run/php${PHPSHORT}-fpm.sock" ]] && ok "php${PHPSHORT}-fpm.sock" || bad "socket missing"

  echo
  echo "Sites in $SITES_DIR"
  local n=0
  for d in "$SITES_DIR"/*/; do [[ -d "$d" ]] && n=$((n+1)); done
  echo "  $n project(s)"
}

cmd_start() {
  brew services start "php@$PHP_VERSION"
  echo "dnsmasq and nginx need root:"
  sudo brew services start dnsmasq
  sudo brew services start nginx
}

cmd_stop() {
  brew services stop "php@$PHP_VERSION" || true
  sudo brew services stop nginx || true
  sudo brew services stop dnsmasq || true
}

cmd_reload() {
  "$(dirname "${BASH_SOURCE[0]}")/site-cert-regen"
  sudo nginx -s reload && ok "nginx reloaded"
}

cmd_logs() { tail -f "$BREW/var/log/nginx/${TLD}-error.log"; }

cmd_doctor() {
  echo "Checks"
  [[ -f "/etc/resolver/$TLD" ]] && ok "/etc/resolver/$TLD present" \
    || bad "/etc/resolver/$TLD missing — .$TLD will not resolve"

  if dig +short +time=2 +tries=1 @127.0.0.1 "probe.$TLD" 2>/dev/null | grep -q 127.0.0.1; then
    ok "dnsmasq answers *.$TLD"
  else
    bad "dnsmasq is not answering *.$TLD"
  fi

  security find-certificate -c mkcert /Library/Keychains/System.keychain >/dev/null 2>&1 \
    && ok "mkcert CA trusted" || bad "mkcert CA not trusted — run: mkcert -install"

  local cert="$BREW/etc/nginx/certs/local-${TLD}.pem"
  if [[ -f "$cert" ]]; then
    local sans; sans=$(openssl x509 -in "$cert" -noout -ext subjectAltName 2>/dev/null | tr ',' '\n' | grep -c 'DNS' || true)
    ok "certificate present ($sans SANs)"
    if openssl x509 -in "$cert" -noout -ext subjectAltName 2>/dev/null | grep -q "DNS:\*\.$TLD"; then
      bad "certificate uses a *.$TLD wildcard — clients reject wildcards directly under a TLD"
    fi
  else
    bad "certificate missing — run site-cert-regen"
  fi

  # A root-owned shared php-fpm log makes launchd fail php@X with status 78.
  local shared="$BREW/var/log/php-fpm.log"
  if [[ -f "$shared" && ! -w "$shared" ]]; then
    bad "$shared is not writable by you — php-fpm may fail to start (status 78)"
  fi

  nginx -t 2>&1 | grep -q 'syntax is ok' && ok "nginx config syntax ok" \
    || warn "run 'sudo nginx -t' for a full config check"
}


# --- php version -----------------------------------------------------------
current_fpm_version() {
  # Read the version nginx is actually wired to, not what the env says.
  # -E for portability: macOS ships BSD sed, which lacks the GNU \+ operator.
  sed -nE 's|.*fastcgi_pass unix:.*/php([0-9]+)-fpm\.sock.*|\1|p' \
      "$BREW/etc/nginx/servers/local-dev.conf" 2>/dev/null | head -1
}

cmd_php() {
  local target="${1:-}"
  local short cur
  cur="$(current_fpm_version)"

  if [[ -z "$target" ]]; then
    echo "PHP"
    [[ -n "$cur" ]] && ok "nginx serves via php${cur}-fpm.sock" || bad "nginx has no php-fpm socket configured"
    echo "  cli:       $(php -v 2>/dev/null | head -1 || echo 'not on PATH')"
    echo
    echo "Installed Homebrew PHP versions:"
    brew list --formula 2>/dev/null | grep -E '^php(@[0-9.]+)?$' | sed 's/^/  /'
    echo
    echo "Switch with:  devstack php 8.4"
    return 0
  fi

  [[ "$target" =~ ^[0-9]+\.[0-9]+$ ]] || { bad "Version must look like 8.3 or 8.4"; exit 1; }
  short="${target//./}"

  if ! brew list --versions "php@$target" >/dev/null 2>&1; then
    echo "Installing php@$target…"
    brew install "php@$target"
  fi

  local pool="$BREW/etc/php/$target/php-fpm.d/www.conf"
  local conf="$BREW/etc/php/$target/php-fpm.conf"
  [[ -f "$pool" ]] || { bad "No pool config at $pool"; exit 1; }

  cp "$pool" "$pool.bak-$(date +%Y%m%d%H%M%S)"
  /usr/bin/sed -i '' \
    -e "s|^listen = .*|listen = $BREW/var/run/php${short}-fpm.sock|" \
    -e "s|^;\{0,1\}listen.owner = .*|listen.owner = $USER|" \
    -e "s|^;\{0,1\}listen.group = .*|listen.group = $(id -gn)|" \
    -e "s|^;\{0,1\}listen.mode = .*|listen.mode = 0660|" "$pool"
  cp "$conf" "$conf.bak-$(date +%Y%m%d%H%M%S)"
  /usr/bin/sed -i '' "s|^;\{0,1\}error_log = .*|error_log = $BREW/var/log/php-fpm-${target}.log|" "$conf"
  ok "php@$target configured on its own socket and log"

  # Point nginx at the new socket.
  local vhost="$BREW/etc/nginx/servers/local-dev.conf"
  cp "$vhost" "$vhost.bak-$(date +%Y%m%d%H%M%S)"
  /usr/bin/sed -i '' "s|php[0-9]\{2,3\}-fpm\.sock|php${short}-fpm.sock|" "$vhost"
  ok "nginx vhost points at php${short}-fpm.sock"

  # Stop the version we were using, start the new one.
  if [[ -n "$cur" && "$cur" != "$short" ]]; then
    local oldver="${cur:0:1}.${cur:1}"
    brew services stop "php@$oldver" >/dev/null 2>&1 && ok "stopped php@$oldver"
  fi
  brew services start "php@$target" >/dev/null && ok "started php@$target"

  # Keep the CLI on the same version — a CLI/FPM mismatch silently produces
  # dependencies resolved against one version and executed under another.
  brew unlink php >/dev/null 2>&1 || true
  for v in $(brew list --formula 2>/dev/null | grep -E '^php@[0-9.]+$'); do
    [[ "$v" == "php@$target" ]] || brew unlink "$v" >/dev/null 2>&1 || true
  done
  brew link --overwrite --force "php@$target" >/dev/null 2>&1 && ok "cli php linked to $target"

  echo
  echo "  cli: $(php -v 2>/dev/null | head -1)"
  warn "Reload nginx to serve through the new socket:  sudo nginx -s reload"
}

# --- mysql performance_schema ---------------------------------------------
cmd_mysql_perf() {
  local action="${1:-}" cnf="$BREW/etc/my.cnf"
  [[ -f "$cnf" ]] || { bad "No $cnf"; exit 1; }

  local state="ON (MySQL default)"
  grep -qE '^\s*performance_schema\s*=\s*OFF' "$cnf" && state="OFF"

  local live=""
  live="$(mysql -N -e "SHOW VARIABLES LIKE 'performance_schema'" 2>/dev/null | awk '{print $2}')"

  if [[ -z "$action" ]]; then
    echo "MySQL performance_schema"
    echo "  configured: $state"
    [[ -n "$live" ]] && echo "  running:    $live" || warn "MySQL not reachable — cannot read live value"
    local pid; pid="$(pgrep -x mysqld | head -1)"
    if [[ -n "$pid" ]] && command -v footprint >/dev/null 2>&1; then
      echo "  memory:     $(footprint -p "$pid" 2>/dev/null | grep -m1 'phys_footprint:' | grep -oE '[0-9.]+ [KMG]B')"
    fi
    echo
    echo "  ON  costs roughly 200 MB of pre-allocated memory, whether or not you query it."
    echo "  Toggle with:  devstack mysql-perf on|off"
    return 0
  fi

  cp "$cnf" "$cnf.bak-$(date +%Y%m%d%H%M%S)"
  case "$action" in
    off)
      if grep -qE '^\s*#\s*performance_schema' "$cnf"; then
        /usr/bin/sed -i '' 's|^\s*#\s*performance_schema.*|performance_schema      = OFF|' "$cnf"
      elif ! grep -qE '^\s*performance_schema' "$cnf"; then
        printf '\nperformance_schema      = OFF\n' >> "$cnf"
      fi
      ok "performance_schema = OFF"
      ;;
    on)
      /usr/bin/sed -i '' 's|^\s*performance_schema\s*=\s*OFF.*|# performance_schema    = OFF  (enabled)|' "$cnf"
      ok "performance_schema enabled (MySQL default)"
      ;;
    *) bad "Use: devstack mysql-perf on|off"; exit 1 ;;
  esac

  echo "Restarting MySQL…"
  brew services restart mysql >/dev/null
  # MySQL reports "started" before the socket is ready; poll rather than sleep.
  local i
  for i in $(seq 1 30); do mysql -N -e "SELECT 1" >/dev/null 2>&1 && break; sleep 1; done
  if mysql -N -e "SELECT 1" >/dev/null 2>&1; then
    ok "MySQL up (performance_schema = $(mysql -N -e "SHOW VARIABLES LIKE 'performance_schema'" 2>/dev/null | awk '{print $2}'))"
    local pid; pid="$(pgrep -x mysqld | head -1)"
    [[ -n "$pid" ]] && command -v footprint >/dev/null 2>&1 && \
      echo "  memory: $(footprint -p "$pid" 2>/dev/null | grep -m1 'phys_footprint:' | grep -oE '[0-9.]+ [KMG]B')"
  else
    bad "MySQL did not come back — check $cnf and its backup"
  fi
  [[ "$action" == "off" ]] && warn "performance_schema.* and information_schema.global_variables are now unavailable; use SHOW VARIABLES / SHOW STATUS"
  return 0
}

case "${1:-}" in
  status) cmd_status ;;
  php)    shift; cmd_php "${1:-}" ;;
  mysql-perf) shift; cmd_mysql_perf "${1:-}" ;;
  start)  cmd_start ;;
  stop)   cmd_stop ;;
  reload) cmd_reload ;;
  logs)   cmd_logs ;;
  doctor) cmd_doctor ;;
  *) usage; exit 1 ;;
esac
