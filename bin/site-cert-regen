#!/usr/bin/env bash
#
# Regenerate the local development certificate.
#
# Why not a wildcard: a "*.test" certificate puts the wildcard directly under a
# TLD, which BOTH OpenSSL and Apple's TLS stack reject — the same rule that
# blocks "*.com". `openssl s_client` will happily display such a cert, so it
# passes a naive check and then fails in every real client. We therefore
# enumerate one explicit SAN per project directory.
#
# Re-run after adding a project, then: sudo nginx -s reload
#
set -euo pipefail

# Settings resolve as: environment variable > config file > default.
# The config file is written by install.sh so the CLI uses the same sites
# directory, TLD and PHP version the stack was actually configured with.
CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/brew-dev-stack/config"
_env_TLD="${TLD:-}"; _env_SITES="${SITES_DIR:-}"; _env_PHP="${PHP_VERSION:-}"
# shellcheck source=/dev/null
[[ -f "$CONFIG_FILE" ]] && . "$CONFIG_FILE"
TLD="${_env_TLD:-${TLD:-test}}"
SITES_DIR="${_env_SITES:-${SITES_DIR:-$HOME/sites}}"
PHP_VERSION="${_env_PHP:-${PHP_VERSION:-8.3}}"
BREW="$(brew --prefix)"
CERTDIR="$BREW/etc/nginx/certs"

command -v mkcert >/dev/null || { echo "mkcert not installed (brew install mkcert)" >&2; exit 1; }
mkdir -p "$CERTDIR"

names=("$TLD" localhost 127.0.0.1 ::1)
skipped=()

for d in "$SITES_DIR"/*/; do
  [[ -d "$d" ]] || continue
  n="$(basename "$d")"
  # Valid DNS label only: letters, digits, hyphens; no spaces, no leading/trailing dash.
  if printf '%s' "$n" | grep -qE '^[a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?$'; then
    names+=("${n}.${TLD}")
  else
    skipped+=("$n")
  fi
done

# Cover hostnames served by vhosts that are not project directories
# (mailpit, and anything else you add under servers/).
for conf in "$BREW"/etc/nginx/servers/*.conf; do
  [[ -f "$conf" ]] || continue
  while IFS= read -r extra; do
    [[ "$extra" == *".$TLD" ]] || continue
    [[ " ${names[*]} " == *" $extra "* ]] || names+=("$extra")
  done < <(sed -nE 's|^[[:space:]]*server_name[[:space:]]+([a-zA-Z0-9.-]+)[[:space:]]*;.*|\1|p' "$conf")
done

echo "Generating certificate for ${#names[@]} names…"
cd "$CERTDIR"
mkcert -cert-file "local-${TLD}.pem" -key-file "local-${TLD}-key.pem" "${names[@]}"

if (( ${#skipped[@]} )); then
  echo
  echo "Skipped ${#skipped[@]} directory name(s) that are not valid hostnames:"
  printf '  %s\n' "${skipped[@]}"
  echo "  (rename them without spaces to have them served)"
fi

echo
echo "Reload nginx to pick it up:  sudo nginx -s reload"
